# Google Gemini API Key (100% Free - Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel Username (e.g. @my_ai_channel) or Private Chat ID (e.g. -100123456789)
TELEGRAM_CHAT_ID=@your_channel_username

# Authorized Telegram username for on-demand triggers
ALLOWED_TELEGRAM_USER=tqzdh
